# =============================================================================
# ATT&CK Knowledge Pipeline (Liszt) — Environment Variables
# Copy to .env and fill in your values. All vars are prefixed LISZT_.
# =============================================================================

# --- MongoDB -----------------------------------------------------------------
LISZT_MONGO_URI=mongodb://localhost:27017
LISZT_DB_NAME=liszt
LISZT_DB_SECURE_NAME=liszt_secure

# --- S3 / MinIO --------------------------------------------------------------
# Local MinIO: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
LISZT_S3_ENDPOINT_URL=http://localhost:9000
LISZT_S3_ACCESS_KEY=minioadmin
LISZT_S3_SECRET_KEY=minioadmin
LISZT_S3_REGION=us-east-1
LISZT_S3_BUCKET_BUNDLES=attck-bundles
LISZT_S3_BUCKET_REPORTS=liszt-reports
LISZT_S3_ENABLE_OBJECT_LOCK=false

# --- GitHub (release watch) --------------------------------------------------
# Optional. Without a token, polling is limited to 60 req/hr.
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
LISZT_GITHUB_TOKEN=
LISZT_WATCH_INTERVAL_SECONDS=3600

# --- Notion (overlay sync & drift comments) ----------------------------------
# Create an internal integration at: https://www.notion.so/my-integrations
# Then share the ATTCK Data database with the integration.
LISZT_NOTION_TOKEN=
LISZT_NOTION_COLLECTION_ID=5c2aa5cc-1ca1-4742-bf5d-57d55fa8507d

# --- STIX source -------------------------------------------------------------
LISZT_STIX_DATA_REPO=mitre-attack/attack-stix-data
LISZT_STIX_DATA_BRANCH=master

# --- Custom namespace --------------------------------------------------------
LISZT_CUSTOM_DOMAIN=cmndcntrl-custom
LISZT_CUSTOM_NAMESPACE_PREFIX=x-cmndcntrl-custom-

# --- Pipeline tuning ---------------------------------------------------------
LISZT_RETENTION_YEARS=7
LISZT_DESCRIPTION_CHANGE_SEVERITY=low
# Domains to watch for new releases (comma-separated in shell, JSON list in .env)
LISZT_WATCH_DOMAINS='["enterprise-attack","mobile-attack","ics-attack"]'
